{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "!.next/dev/**"
      ],
      "env": [
        "DATABASE_URL",
        "BETTER_AUTH_*",
        "RESEND_API_KEY",
        "EMAIL_FROM",
        "ANTHROPIC_API_KEY",
        "AI_MODEL",
        "AI_MODEL_FAST",
        "CHANNEL3_API_KEY",
        "JINA_*",
        "KERNEL_API_KEY",
        "R2_*",
        "PAYPAL_*"
      ]
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ]
    },
    "check-types": {
      "dependsOn": [
        "^check-types"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "cache": false,
      "env": [
        "TEST_DATABASE_URL"
      ]
    }
  }
}
