"h":24},{"text":"You approve each payment in your assistant.","tag":"div","x":836,"y":1722,"w":278,"h":20},{"text":"Ask me before it pays","tag":"button","x":1408,"y":1706,"w":48,"h":28},{"text":"Make offers on its own","tag":"div","x":836,"y":1779,"w":266,"h":24},{"text":"Up to the ceiling you give it for each thing.","tag":"div","x":836,"y":1803,"w":266,"h":20},{"text":"Make offers on its own","tag":"button","x":1408,"y":1787,"w":48,"h":28},{"text":"Message sellers as me","tag":"div","x":836,"y":1860,"w":351,"h":24},{"text":"Sellers always see when a message came from an agent.","tag":"div","x":836,"y":1884,"w":351,"h":20},{"text":"Message sellers as me","tag":"button","x":1408,"y":1868,"w":48,"h":28},{"text":"Every order is paid through PayPal and held until it arrives.","tag":"p","x":144,"y":2039,"w":392,"h":20},{"text":"","tag":"svg","x":144,"y":2040,"w":18,"h":18},{"text":"How it works","tag":"a","x":1030,"y":2039,"w":82,"h":20},{"text":"Buyer protection","tag":"a","x":1140,"y":2039,"w":105,"h":20},{"text":"Connect your agent","tag":"a","x":1273,"y":2039,"w":125,"h":20},{"text":"Help","tag":"a","x":1426,"y":2039,"w":30,"h":20}]