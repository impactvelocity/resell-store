# Marketplace on the root, each store on its own subdomain (maya.localhost:5689)
NEXT_PUBLIC_ROOT_DOMAIN=localhost:5689

# Postgres with pgvector. Local: `pnpm db:up && pnpm db:migrate` from the repo root
DATABASE_URL=postgres://resell:resell@localhost:5433/resell

# Better Auth. Secret: `openssl rand -hex 32`
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:5689


# Email (sign-in links). Without a key, local dev shows the link on the page instead
RESEND_API_KEY=
EMAIL_FROM="resell.store <hello@resell.store>"

# Uploads in Cloudflare R2 (S3 API). Without these, files are kept in Postgres
# R2_URL is the account endpoint: https://{account_id}.r2.cloudflarestorage.com
R2_URL=
R2_ACCESS_KEY=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=resell-store
# Optional: a public bucket domain to serve files from directly. r2.dev is fine for dev;
# Cloudflare rate-limits it, so use a custom domain (e.g. files.resell.store) in production
R2_PUBLIC_URL=

# The agent. Models are "provider:model"
ANTHROPIC_API_KEY=
AI_MODEL=anthropic:claude-sonnet-5
AI_MODEL_FAST=anthropic:claude-haiku-4-5

# Product research: https://trychannel3.com/developers
CHANNEL3_API_KEY=

# Semantic search embeddings: https://jina.ai/embeddings
JINA_EMBEDDING_MODEL_KEY=
JINA_EMBEDDING_MODEL=jina-embeddings-v5-text-small

# Cloud browsers for listing comps and the shopping sidekick (needs ANTHROPIC_API_KEY too): https://www.kernel.sh
KERNEL_API_KEY=

# Payments: PayPal multiparty, sandbox only (https://developer.paypal.com/dashboard)
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Testing Tools > Sandbox Accounts > Platform Partner App > Account ID
PAYPAL_PARTNER_MERCHANT_ID=
# App Settings > Reports: sent as the PayPal-Partner-Attribution-Id header
PAYPAL_BN_CODE=
# Sandbox only: the shared demo seller. Sellers who haven't connected PayPal are paid here,
# and "Use demo PayPal" on Connections links to it. Connect it once with
# `node --env-file=.env.local scripts/paypal-demo-seller.mjs`, which prints its merchant id.
PAYPAL_DEMO_SELLER_ID=
# Sandbox only: shared PayPal test logins shown to people trying the demo
# (the seller's on Connections, to watch sales land; the buyer's at checkout)
PAYPAL_DEMO_SELLER_EMAIL=
PAYPAL_DEMO_SELLER_PASSWORD=
PAYPAL_DEMO_BUYER_EMAIL=
PAYPAL_DEMO_BUYER_PASSWORD=
# Developer Dashboard > your app > Webhooks: point it at {site}/api/paypal/webhook and paste its id here.
# Events: PAYMENT.CAPTURE.*, CUSTOMER.DISPUTE.*, MERCHANT.ONBOARDING.COMPLETED,
# MERCHANT.PARTNER-CONSENT.REVOKED, PAYMENT.REFERENCED-PAYOUT-ITEM.*
PAYPAL_WEBHOOK_ID=
# Optional: platform fee in basis points of the item price (1000 = 10%)
PLATFORM_FEE_BPS=
# Demo only: minutes per "day" for the auto-release timers, to show a release live
PAYOUT_DEMO_MINUTES_PER_DAY=

# Where escalated problems are emailed for a decision
SUPPORT_EMAIL=

# Timed jobs (lib/server/sweeps.ts). In production a Render Workflow runs them, started by a
# Render Cron Job with these two. Locally or without Render, POST /api/cron/sweep runs them
# in-process (needs `Authorization: Bearer $CRON_SECRET` outside development).
RENDER_API_KEY=
RENDER_WORKFLOW_SLUG=resell-sweeps
CRON_SECRET=

# Tests use their own database on the same server (created and migrated automatically)
TEST_DATABASE_URL=postgres://resell:resell@localhost:5433/resell_test

# logo.dev publishable key (pk_...), for company logos on the landing page
NEXT_PUBLIC_LOGO_DEV_TOKEN=
